# ---------------------------------------------------------
# SODChecks - Environment Configuration
# ---------------------------------------------------------

# Flask Configuration
# Used for encrypting session cookies. Change this in production.
FLASK_SECRET_KEY=YourSuperSecretKey123!@#
FLASK_ENV=development

# ---------------------------------------------------------
# Notification Integrations
# ---------------------------------------------------------

# Microsoft Teams Integration
# The Webhook URL used by the TeamsNotificationCheckRunner
TEAMS_WEBHOOK_URL=https://your-teams-webhook-url

# Email Notifications Configuration
# The SMTP setup used by the EmailCheckRunner
SMTP_SERVER=smtp.yourbank.internal
SMTP_PORT=25
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=sodchecks@yourbank.internal

# Note: Tests in the `tests/` directory will read these variables 
# if they trigger notification or external services.
